# RazorShield AI — Frontend Environment Variables (Vercel / Local)
# For local dev with Vite proxy, leave empty or set to http://localhost:8000
# For Vercel production deployment, set to your Render backend URL:
# Example: VITE_API_URL=https://razorshield-backend.onrender.com

VITE_API_URL=https://your-backend-name.onrender.com

# (Optional) Explicit WebSocket endpoint if different from VITE_API_URL:
# VITE_WS_URL=wss://your-backend-name.onrender.com/api/v1/ws/stream
